{
  "encoding": [ "Some", "UTF-8" ],
  "name": "ocamleditor",
  "version": "2.0.0-ocaml530",
  "autocomp": { "delay": 0.764 },
  "targets": [
    {
      "id": 4,
      "name": "common",
      "opt": true,
      "files": "common/common.ml",
      "includes": "common +unix +str",
      "thread": true,
      "cflags": "-g",
      "lflags": "-g",
      "target_type": "Library",
      "outname": "common/common"
    },
    {
      "id": 10,
      "name": "icons",
      "opt": true,
      "files": "icons/icons.ml",
      "package": "lablgtk2",
      "includes": "common icons",
      "cflags": "-g",
      "lflags": "-g",
      "target_type": "Library",
      "outname": "icons/icons",
      "external_tasks": [
        {
          "name": "mkicons",
          "always_run_in_script": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [ [ true, "tools/mkicons.ml" ] ],
          "phase": [ "Some", "Before_compile" ]
        }
      ],
      "dependencies": [ 4 ]
    },
    {
      "id": 7,
      "name": "oebuildlib",
      "opt": true,
      "files": "oebuild/oebuild.ml oebuild/oebuild_dep_ext.ml",
      "includes": "common oebuild +unix +str",
      "thread": true,
      "cflags": "-w y",
      "target_type": "Library",
      "outname": "oebuildlib",
      "dependencies": [ 4 ]
    },
    {
      "id": 5,
      "name": "oebuild",
      "opt": true,
      "libs": "common",
      "files": "oebuild/oebuild_tool.ml",
      "package": "str,unix",
      "includes": "common oebuild",
      "thread": true,
      "cflags": "-w y",
      "outname": "oebuild/oebuild",
      "dependencies": [ 7 ]
    },
    {
      "id": 8,
      "name": "gmisclib",
      "descr": "Miscellaneous widgets based on LablGtk2.",
      "opt": true,
      "files": "gmisclib/gmisclib.ml",
      "package": "lablgtk2",
      "includes": "gmisclib +unix",
      "cflags": "-g",
      "lflags": "-g",
      "target_type": "Library",
      "outname": "gmisclib",
      "lib_install_path": "gmisclib",
      "is_fl_package": true
    },
    {
      "id": 9,
      "name": "otherwidgets",
      "opt": true,
      "libs": "gmisclib",
      "files": "otherwidgets/otherwidgets.ml",
      "package": "lablgtk2",
      "includes": "icons common otherwidgets gmisclib",
      "cflags": "-w -s-y -g",
      "lflags": "-w -s-y -g",
      "target_type": "Library",
      "outname": "otherwidgets",
      "dependencies": [ 8 ]
    },
    {
      "id": 14,
      "name": "ocamleditor-lib",
      "byt": false,
      "opt": true,
      "files": "ocamleditor_lib.ml",
      "package": "atdgen-runtime,curl,dynlink,lablgtk2,ocamldiff,ocp-indent.lib,str,unix,xml-light,yojson,compiler-libs,odoc,ocamldoc,inotify",
      "includes": "gmisclib common icons otherwidgets oebuild ",
      "thread": true,
      "inline": [ "Some", 50 ],
      "cflags": "-w -s-y-x-m -g",
      "lflags": "-g",
      "target_type": "Library",
      "outname": "ocamleditor_lib",
      "dependencies": [ 4, 10, 5, 28, 8, 9, 20 ]
    },
    {
      "id": 12,
      "name": "ocamleditor",
      "default": true,
      "byt": false,
      "opt": true,
      "libs": "ocamlcommon ocamldoc/odoc_info gmisclib common icons otherwidgets oebuildlib ocamleditor_lib",
      "files": "ocamleditor.ml",
      "package": "atdgen-runtime,curl,dynlink,lablgtk2,ocamldiff,ocp-indent.lib,str,unix,xml-light,yojson,compiler-libs,odoc,ocamldoc,inotify",
      "includes": "gmisclib common icons otherwidgets oebuild",
      "thread": true,
      "inline": [ "Some", 50 ],
      "nodep": true,
      "cflags": "-w -s-y-x-m -g",
      "lflags": "-g",
      "outname": "ocamleditor",
      "dependencies": [ 14, 19, 16, 22 ],
      "subsystem": [ "Some", "Console" ]
    },
    {
      "name": "ocamleditor-bytecode",
      "libs": "ocamlcommon ocamldoc/odoc_info gmisclib common icons otherwidgets oebuildlib ocamleditor_lib",
      "files": "ocamleditor.ml",
      "package": "atdgen-runtime,curl,dynlink,lablgtk2,ocamldiff,ocp-indent.lib,str,unix,xml-light,yojson,compiler-libs,odoc,ocamldoc,inotify",
      "includes": "gmisclib common icons otherwidgets oebuild ",
      "thread": true,
      "cflags": "-w -s-y-x-m -g",
      "lflags": "-g",
      "outname": "ocamleditor",
      "dependencies": [ 4, 10, 7, 5, 8, 9, 20, 17, 18 ],
      "subsystem": [ "Some", "Console" ]
    },
    {
      "id": 20,
      "name": "prepare-build",
      "target_type": "External",
      "external_tasks": [
        {
          "name": "prepare-build",
          "always_run_in_script": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [ [ true, "tools/prepare_build.ml" ] ],
          "phase": [ "Some", "Compile" ]
        }
      ],
      "subsystem": [ "Some", "Console" ]
    },
    {
      "id": 28,
      "name": "launcher",
      "descr": "Utility to open OCaml files from the file manager",
      "byt": false,
      "opt": true,
      "libs": "common",
      "files": "ocamleditor_launcher.ml",
      "package": "unix,str",
      "includes": "common",
      "dontaddopt": true,
      "cflags": "-compact",
      "lflags": "-compact",
      "outname": "ocamleditorw",
      "restrictions": [ "OCAML(system<>mingw)" ]
    },
    {
      "id": 13,
      "name": "tools",
      "target_type": "External",
      "external_tasks": [
        {
          "name": "mkrelease",
          "always_run_in_script": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [ [ true, "tools/mkrelease.ml" ] ],
          "phase": [ "Some", "Before_clean" ]
        },
        {
          "name": "mkversion",
          "always_run_in_script": true,
          "dir": "../tools",
          "cmd": "ocaml",
          "args": [ [ true, "mkversion.ml" ], [ true, "2.0.0-ocaml530" ] ],
          "phase": [ "Some", "Before_clean" ]
        },
        {
          "name": "generate_oebuild_script",
          "always_run_in_script": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [
            [ true, "tools/prepare_build.ml" ],
            [ true, "-generate-oebuild-script" ]
          ],
          "phase": [ "Some", "Before_clean" ]
        },
        {
          "name": "Install OCamlEditor",
          "always_run_in_script": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [ [ true, "tools/install.ml" ] ],
          "phase": [ "Some", "Before_clean" ]
        },
        {
          "name": "Uninstall OCamlEditor",
          "always_run_in_script": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [ [ true, "tools/uninstall.ml" ] ],
          "phase": [ "Some", "Before_clean" ]
        },
        {
          "name": "distclean",
          "always_run_in_script": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [ [ true, "tools/distclean.ml" ] ],
          "phase": [ "Some", "Before_clean" ]
        }
      ],
      "subsystem": [ "Some", "Console" ]
    },
    {
      "id": 27,
      "name": "FINDLIB-TOOLS",
      "target_type": "External",
      "external_tasks": [
        {
          "name": "install",
          "readonly": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [ [ true, "tools/findlib.ml" ], [ true, "install" ] ]
        },
        {
          "name": "uninstall",
          "readonly": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [ [ true, "tools/findlib.ml" ], [ true, "uninstall" ] ]
        },
        {
          "name": "reinstall",
          "readonly": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [ [ true, "tools/findlib.ml" ], [ true, "reinstall" ] ]
        },
        {
          "name": "print",
          "readonly": true,
          "dir": "..",
          "cmd": "ocaml",
          "args": [ [ true, "tools/findlib.ml" ], [ true, "print" ] ]
        }
      ],
      "readonly": true,
      "node_collapsed": true
    }
  ],
  "executables": [
    {
      "name": "ocamleditor-bytecode",
      "build_task": "<COMPILE>",
      "env": [
        [ true, "OCAMLEDITORPARAM=debug=2,record_backtrace=1" ],
        [ true, "DEBUG_UNDO=0" ]
      ]
    },
    {
      "id": 1,
      "target_id": 12,
      "name": "ocamleditor",
      "default": true,
      "build_task": "<COMPILE>"
    }
  ],
  "build_script": {
    "filename": "build.ml",
    "targets": [
      { "target_id": 4, "show": false },
      { "target_id": 10, "show": false },
      { "target_id": 7, "show": false },
      { "target_id": 5 },
      { "target_id": 8 },
      { "target_id": 9, "show": false },
      { "target_id": 14 },
      { "target_id": 12 },
      {},
      { "target_id": 20, "show": false },
      { "target_id": 28 },
      { "target_id": 13, "show": false },
      { "target_id": 27, "show": false }
    ]
  }
}