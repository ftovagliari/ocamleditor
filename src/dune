(rule
  (targets err_lexer.ml)
  (deps err_lexer.mll)
  (action 
    (progn
      (run echo "-------------- BEGIN err_lexer.ml ---------------")
      (run ocamllex %{deps})
      (run echo "-------------- END err_lexer.ml ---------------")
    )
  )
)

(rule
  (targets err_parser.ml err_parser.mli)
  (deps err_parser.mly)
  (action
    (progn
      (run echo "-------------- BEGIN err_parser.ml ---------------")
      (run ocamlyacc %{deps})
      (run echo "-------------- END err_parser.ml ---------------")
    )
  )
)

